# Copy to .env and fill in. Never commit .env.

# Database: MongoDB (Atlas or local). Local default if empty: mongodb://localhost:27017
MONGO_DB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net
MONGO_DB_NAME=adcreative

# Auth
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me
FRONTEND_URL=http://localhost:3000

# AI (Groq): comma-separated, up to 10 keys, rotated automatically on failure
GROQ_API_KEYS=gsk_key1,gsk_key2
# Model fallback chain (tried in order). These are Groq free-tier models:
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b
# GROQ_VISION_MODEL=            # only needed for image input
# GROQ_MAX_TOKENS=3000          # free tier: ~8K tokens/min per model
# GROQ_MAX_CONTEXT_CHARS=12000

# Instagram / Meta Graph API (either ID variable works; set one)
META_ACCESS_TOKEN=
META_IG_USER_ID=
# INSTAGRAM_ACCOUNT_ID=
